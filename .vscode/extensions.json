{
  // VS Code offers these the first time this folder is opened. Two, not a pile:
  // Live Server is how the site runs, Live Share is how you show it to your
  // teacher — or to your teammate — when it does not.
  //
  // Tailwind CSS IntelliSense is deliberately NOT here. It wants a Tailwind
  // config file to read, and this project loads Tailwind from a CDN with no
  // config and no build step, so it would install and then do nothing. It
  // becomes worth adding in Unit 8, when there IS a build.
  "recommendations": [
    "ritwickdey.LiveServer",
    "ms-vsliveshare.vsliveshare"
  ]
}
